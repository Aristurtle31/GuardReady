%% GuardReady: main classes for the IEEE paper (Fig. 1).
%% Same 19 classes and the same links as the slide 6 diagram
%% (docs/presentation/class_diagram.mmd), with fewer members, no return types
%% and no app boxes, so it stays readable when it spans both columns of the paper.
%% Checked against the code on Oct 18, 2026 (commit ce42856, 247 tests pass).
%% Paste into https://mermaid.live and export a PNG.
%% Arrows: <|-- inheritance, *-- composition, o-- aggregation, --> association.
%% A method marked * is abstract. A method marked $ is a classmethod.
%% # marks a helper method (one underscore).
classDiagram
    direction LR

    class Person {
        <<abstract>>
        +masked_contact()
        +personal_details()
        +summary()
    }
    class Employee {
        <<abstract>>
        +personal_details()
        +summary()
    }
    class Guard {
        +summary()
        +add_credential()
        +readiness()
        +block_reasons()
    }
    class ExpiringDocument {
        <<abstract>>
        +validity_months()*
        +status()
        +renew()
        +make_notice()
    }
    class Credential {
        +typed()
        +is_sensitive()
        +row()
    }
    class License {
        <<proxy>>
        +validity_months()
    }
    class Clearance {
        <<proxy>>
        +validity_months()
    }
    class MedicalCert {
        <<proxy>>
        +validity_months()
        +is_sensitive()
        +row()
    }
    class TrainingCert {
        <<proxy>>
        +validity_months()
    }
    class CredentialVersion {
        +new_values()
    }
    class ClientSite {
        +needed()
    }
    class Post {
        +refusal_reasons()
        +is_full()
    }
    class Assignment {
        +start()$
        +close()
    }
    class AppendOnlyRecord {
        <<abstract>>
        +save()
        +delete()
    }
    class AuditEntry {
        +action: str
        +outcome: str
    }
    class Report {
        <<abstract>>
        +title()*
        +sections()*
        +write_csv()
    }
    class ComplianceReport {
        #_chosen_sections()
    }
    class GuardReport {
        +title()$
    }
    class SummaryReport {
        +title()$
    }

    Person <|-- Employee
    Employee <|-- Guard

    ExpiringDocument <|-- Credential
    Credential <|-- License
    Credential <|-- Clearance
    Credential <|-- MedicalCert
    Credential <|-- TrainingCert

    AppendOnlyRecord <|-- CredentialVersion
    AppendOnlyRecord <|-- AuditEntry

    Report <|-- ComplianceReport
    Report <|-- GuardReport
    Report <|-- SummaryReport

    Guard "1" *-- "0..6" Credential : owns
    Credential "1" <-- "0..*" CredentialVersion : old values of
    ClientSite "1" *-- "1..*" Post : owns
    Post "1" o-- "0..*" Assignment : holds guards through
    Assignment "0..*" --> "1" Guard : guard
