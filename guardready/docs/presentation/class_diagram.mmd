%% GuardReady: main classes for the IT102 presentation (slide 6).
%% Checked against the code on Oct 17, 2026 (after Stage 4, 247 tests pass).
%% Paste into https://mermaid.live to edit it or export a PNG.
%% Boxes are grouped by Django app: guards, deployment, audit, reports.
%% Arrows: <|-- inheritance, *-- composition, o-- aggregation, --> association.
%% Django model fields are public, so they use +. Helper methods with one underscore use #.
%% A method marked * is abstract (the base raises NotImplementedError). A method marked $ is a classmethod.
classDiagram
    direction LR

    namespace guards {
        class Person {
            <<abstract>>
            +first_name: str
            +last_name: str
            +contact_number: str
            +masked_contact() str
            +personal_details() dict
            +summary() str
        }
        class Employee {
            <<abstract>>
            +employee_no: str
            +date_hired: date
            +sss_number: str
            +personal_details() dict
            +summary() str
        }
        class Guard {
            +rank: str
            +guard_type: str
            +summary() str
            +add_credential(doc_type, ...) Credential
            +readiness() str
            +block_reasons() list
        }
        class ExpiringDocument {
            <<abstract>>
            +number: str
            +issued: date
            +expires: date
            +validity_months()* int
            +days_left() int
            +status() str
            +renew(number, issued, expires, by_user) int
            +make_notice() ExpiryNotice
            #_save_version(by_user, changed_at)
        }
        class Credential {
            +kind: str
            +doc_type: str
            +result: str
            +typed() Credential
            +is_sensitive() bool
            +row(unlocked) dict
            #_save_version(by_user, changed_at)
        }
        class License {
            <<proxy>>
            +validity_months() int
        }
        class Clearance {
            <<proxy>>
            +validity_months() int
        }
        class MedicalCert {
            <<proxy>>
            +validity_months() int
            +is_sensitive() bool
            +row(unlocked) dict
            +renew(..., result) int
        }
        class TrainingCert {
            <<proxy>>
            +validity_months() int
        }
        class CredentialVersion {
            +old_number: str
            +old_issued: date
            +old_expires: date
            +changed_at: datetime
        }
    }

    namespace deployment {
        class ClientSite {
            +name: str
            +address: str
            +needed() int
            +filled() int
        }
        class Post {
            +name: str
            +shift: str
            +headcount: int
            +filled_count() int
            +is_full() bool
        }
        class Assignment {
            +start_date: date
            +end_date: date
            +start(guard, post, by_user)$ Assignment
            +close(end_date)
            +is_open() bool
        }
    }

    namespace audit {
        class AppendOnlyRecord {
            <<abstract>>
            +save()
            +delete()
        }
        class AuditEntry {
            +timestamp: datetime
            +username: str
            +role: str
            +action: str
            +outcome: str
            +sensitive: bool
        }
    }

    namespace reports {
        class Report {
            <<abstract>>
            +title()* str
            +sections()* list
            #_request_rows()* list
            +build() Report
            +write_csv(out)
        }
        class ComplianceReport {
            #_request_rows() list
            #_chosen_sections() list
        }
        class GuardReport {
            +title()$ str
            +sections()$ list
            #_request_rows() list
        }
        class SummaryReport {
            +title()$ str
            +sections()$ list
            #_request_rows() list
        }
    }

    Person <|-- Employee
    Employee <|-- Guard

    ExpiringDocument <|-- Credential
    Credential <|-- License
    Credential <|-- Clearance
    Credential <|-- MedicalCert
    Credential <|-- TrainingCert

    AppendOnlyRecord <|-- CredentialVersion
    AppendOnlyRecord <|-- AuditEntry

    Report <|-- ComplianceReport
    Report <|-- GuardReport
    Report <|-- SummaryReport

    Guard "1" *-- "0..6" Credential : owns
    Credential "1" <-- "0..*" CredentialVersion : old values of
    ClientSite "1" *-- "1..*" Post : owns
    Post "1" o-- "0..*" Assignment : holds guards through
    Assignment "0..*" --> "1" Guard : guard
